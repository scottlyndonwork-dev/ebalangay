{
  "name": "ebalangay",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @ebalangay/db db:generate",
    "db:migrate:dev": "pnpm --filter @ebalangay/db db:migrate:dev",
    "db:migrate": "pnpm --filter @ebalangay/db db:migrate",
    "db:studio": "pnpm --filter @ebalangay/db db:studio",
    "db:seed": "pnpm --filter @ebalangay/db db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.2"
}
